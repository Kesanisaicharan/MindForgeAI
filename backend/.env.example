# Copy to .env for local backend development. Never commit real secrets.
PORT=5000
# Comma-separated exact frontend origins; empty allows any origin for local development only.
CORS_ORIGINS=http://localhost:5173
JSON_BODY_LIMIT=2mb
MONGO_URI=mongodb://127.0.0.1:27017/mindforge
GROQ_API_KEY=replace_me
# Optional; email delivery is disabled safely when absent.
RESEND_API_KEY=replace_me
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=replace_me
# Optional trusted teacher user IDs (comma-separated Supabase UUIDs).
# Alternatively set server-managed app_metadata.role = "teacher" for each teacher.
TEACHER_USER_IDS=
