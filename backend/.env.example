# MONGO_URI: The connection string for your MongoDB database.
# You can use a local MongoDB (e.g. mongodb://localhost:27017/mindforge) 
# or a free MongoDB Atlas cloud instance (e.g. mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/mindforge)
MONGO_URI=your_mongodb_connection_uri

# GROQ_API_KEY: Your API Key from groq.com. 
# Used by the backend to generate structured courses and quiz questions.
GROQ_API_KEY=your_groq_api_key

# RESEND_API_KEY: Your Resend API Key from resend.com.
# Used by the backend to send congratulatory emails with certificate instructions.
RESEND_API_KEY=re_your_resend_api_key

# PORT: The port the backend server runs on (defaults to 5000)
PORT=5000
